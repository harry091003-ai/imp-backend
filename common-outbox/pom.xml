<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Same Spring Boot version as the services (3.5.11), like the other common-* modules. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.11</version>
        <relativePath/>
    </parent>

    <groupId>com.project.outbox</groupId>
    <artifactId>common-outbox</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>common-outbox</name>
    <description>The outbox pattern: save a Kafka event in the SAME database transaction as the data,
        and let a small background job send it. So an event can never be lost between "saved" and
        "sent".</description>

    <properties>
        <!-- Java 17, like the other common-* modules: Ai-Service is still on 17. -->
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <dependencies>
        <!-- Our own tiny module: the trace id's header name and safety check. -->
        <dependency>
            <groupId>com.project.trace</groupId>
            <artifactId>common-trace</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- Everything below is 'provided': every service that uses this module already has it.
             We need it to compile; we must not bring a second copy in at runtime. -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- JdbcTemplate + transactions. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Turns the event into JSON and back. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- The auto-config hooks and @ConfigurationProperties. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ===== Tests only ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- A real Kafka broker started inside the test (same as common-kafka's tests). -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- JPA + Hibernate, ONLY to prove the outbox row joins a real JPA transaction,
             the way the services use it. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Dates in events (LocalDateTime) as JSON, like in the services. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- A tiny database that lives in memory during a test, in MySQL mode.
             Version pinned to the one already in the local Maven cache. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
