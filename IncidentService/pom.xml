<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.11</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.example</groupId>
	<artifactId>IncidentService</artifactId>
	<version>0.0.1-SNAPSHOT</version>
    <name>IncidentService</name>
    <description>For managing Incidents</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
    <properties>
        <java.version>21</java.version>
        <spring-cloud.version>2025.0.1</spring-cloud.version>
    </properties>
	<dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway: owns the database schema from now on.
             Runs the SQL files in src/main/resources/db/migration on startup,
             BEFORE Hibernate gets involved.
             No <version> here on purpose - spring-boot-starter-parent picks a
             Flyway version tested against this Spring Boot release. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- Flyway 10+ split each database's support into its own module.
             Without flyway-mysql, Flyway starts and then fails with
             "Unsupported Database: MySQL". flyway-core alone is not enough. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Tests only: a tiny in-memory database (MySQL mode), so the outbox tests can run the real
             IncidentService code without a real MySQL. Version = the one already in the local cache. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
            <scope>test</scope>
        </dependency>
        <!-- Tests only: a real Kafka broker started inside the test (IncidentEventsOverKafkaTest). -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
<!--        <dependency>-->
<!--            <groupId>com.example</groupId>-->
<!--            <artifactId>AuthService</artifactId>-->
<!--            <version>0.0.1-SNAPSHOT</version>-->
<!--            <scope>compile</scope>-->
<!--        </dependency>-->

        <!--        For Enabling Kafka-->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <dependency>
            <groupId>com.project.security</groupId>
            <artifactId>common-security</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- Shared HTTP error contract: exception family + global @RestControllerAdvice.
             Auto-configures itself, no wiring needed in this service. -->
        <dependency>
            <groupId>com.project.web</groupId>
            <artifactId>common-web</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- C1 step 3: puts the trace id on every Kafka message this service SENDS (a message
             header), so the services that receive it can carry the same number in their logs.
             Auto-configures itself, no wiring needed. This service only sends, it has no
             listeners, so the retry / dead-letter part of common-kafka simply sits unused. -->
        <dependency>
            <groupId>com.project.kafka</groupId>
            <artifactId>common-kafka</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- Outbox step 2: events are saved in the SAME database transaction as the incident and
             sent to Kafka a moment later by a background relay. So an event can never be lost
             between "incident saved" and "event sent". Auto-configures itself. The table comes
             from Flyway V3__outbox_event.sql. -->
        <dependency>
            <groupId>com.project.outbox</groupId>
            <artifactId>common-outbox</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- ✅ Load Balancer: turns a service NAME like "USERSERVICE" into a real
             address, by asking Eureka. Feign uses this too, exactly as WebClient did. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- ADDED 2026-09-09 (Track B3, step 2): Feign, our HTTP client for calling
             other services.

             WHY WE SWITCHED TO IT
             Before this, UserClient used WebClient and then called .block() on every
             call. That was the wrong pairing: WebClient is built for reactive apps
             that never sit and wait, and .block() forces it to sit and wait anyway.
             We paid for machinery we then threw away.

             This service is a normal Spring MVC service - one thread per request,
             and that thread is SUPPOSED to wait. So it needs a client that waits by
             design, not one bent into waiting.

             Feign is that client, and Ai-Service already uses it. Same tool
             everywhere is one less thing to learn.

             No <version> - the spring-cloud-dependencies BOM lower down picks a
             version tested against our Spring Cloud release. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <!-- For using the Event (DTO) Form Shared Events module   -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>shared-events</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <!-- NOTE 2026-09-09 (Track B3, step 2): nothing in our code uses WebClient any
             more - Feign replaced it. This is now unused and could be deleted.
             BUt we are still not deleting it now because: deleting it might accidentally
             remove other libraries that hidden dependencies need. They'll delete it separately
             so they can test it on its own.  -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
